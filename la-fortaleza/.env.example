# Local (desarrollo en tu PC)
DATABASE_URL=file:./data/la-fortaleza.db
USE_TURSO=false

# Producción (Vercel + Turso) — pon estos en Vercel → Settings → Environment Variables
# USE_TURSO=true
# TURSO_DATABASE_URL=libsql://la-fortaleza-XXXX.turso.io
# TURSO_AUTH_TOKEN=eyJ...

JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=8h

# Seed local (npm run db:seed)
SEED_SUPER_USERNAME=admin
SEED_SUPER_PASSWORD=Admin123!
SEED_SUPER_NAME=Super Usuario
